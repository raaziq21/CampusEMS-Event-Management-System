# ===========================================
# Server Configuration
# ===========================================
PORT=5000
NODE_ENV=development

# ===========================================
# MongoDB Connection (MongoDB Atlas)
# ===========================================
# Get your connection string from: https://cloud.mongodb.com
# Replace <username>, <password>, and <cluster> with your values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ems_db?retryWrites=true&w=majority

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=your_jwt_secret_here_replace_with_a_strong_random_string
JWT_EXPIRES_IN=7d

# ===========================================
# CORS Configuration
# ===========================================
CLIENT_URL=http://localhost:8080

# ===========================================
# Bcrypt Configuration
# ===========================================
BCRYPT_SALT_ROUNDS=10
